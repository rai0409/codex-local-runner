{
  "batch_id": "example",
  "goal": "Example two-step batch demonstrating the safe prompt-batch controller",
  "max_prompts": 5,
  "stop_on_failure": true,
  "require_clean_source_before_each_prompt": true,
  "require_commit_tag_per_prompt": true,
  "prompts": [
    {
      "prompt_id": "prompt-example-001",
      "prompt_path": "001_example_prompt.md",
