      "expected_report_path": "artifacts/autonomous_runtime/prompt_example_001_report.json",
      "expected_summary_path": "artifacts/autonomous_runtime/prompt_example_001_summary.md",
      "required_tests": ["python -m unittest tests.test_project_prompt_batch_controller"],
      "pass_conditions": {"status_field": "example_001_status", "status_value": "success"}
    },
    {
      "prompt_id": "prompt-example-002",
      "prompt_path": "002_example_prompt.md",
      "expected_tag": "prompt-example-002",
      "expected_report_path": "artifacts/autonomous_runtime/prompt_example_002_report.json",
      "expected_summary_path": "artifacts/autonomous_runtime/prompt_example_002_summary.md",
      "required_tests": [],
      "pass_conditions": {"status_field": "example_002_status", "status_value": "success"}
    }
  ]
}
