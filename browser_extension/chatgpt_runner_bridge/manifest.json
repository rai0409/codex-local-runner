{
  "manifest_version": 3,
  "name": "ChatGPT Runner Bridge",
  "version": "0.1.1",
  "description": "Operator-controlled ChatGPT page bridge that emits local validation envelopes.",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://*/*"
  ],
  "action": {
    "default_title": "Run ChatGPT Bridge"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
